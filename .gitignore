*.suo
# Some Visual Studio versions
*.sln.ide
# Visual Studio temporary database
*.VC.opendb
# Visual Studio code Browse database
*.VC.db
# Visual Studio
*.VC.VC.opendb
# IntelliJ/CLion project files
.idea/
# VS Code workspace settings (optional - commit if shared config is vital)
.vscode/
