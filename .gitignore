### Compilation and Build Output
### General build output directories and files for various platforms
### IMPORTANT: These should NOT contain your source code or essential project definitions.
### If your project definitions (e.g., .xcodeproj) are INSIDE these,
### you'll need explicit exceptions later.
# Common build output directory (e.g., CMake out-of-source builds)
build*/
# Or if you symlink to a specific build output directory
/build
# clangd cache
.cache/
# Compiled binaries directory
bin/
# Object files directory
obj/
# Object files (Unix/MinGW)
*.o
# Library object files
*.lo
# Libtool files
*.la
# Shared libraries
*.so
# Windows dynamic link libraries
*.dll
# macOS dynamic libraries
*.dylib
# Executables
*.exe
# Windows object files
*.obj
# Windows static libraries
*.lib
# Program Database (debug info)
*.pdb
# Incremental Linker File
*.ilk
# Export files
*.exp
# Intermediate Debugging Information
*.idb

### Audio Plugin & Application Formats (Built output, ignore these)
# Avid AAX plugin bundles (macOS directory/bundle)
*.aaxplugin/
# Older VST 1/2 plugin bundles (macOS directory/bundle)
*.vst/
# VST3 plugin bundles (macOS directory/bundle)
*.vst3/
# Audio Unit plugin bundles (macOS directory/bundle)
*.component/
# macOS Application bundles (as directory)
*.app/
# For completeness, also ignore these as files, though typically covered by directory ignores
*.aaxplugin
*.vst
*.vst3
*.component
*.exe
*.app

