      <luaMethod luaMethodName="probeInit" luaMethodCode="probeInit = function()&#10;end&#10;&#10;paintCount = 0&#10;probeLog = {}&#10;&#10;-- One entry per mouse callback, with everything a drawing surface would ask a MouseEvent.&#10;probeRecord = function(kind, e, dx, dy)&#10;&#09;probeLog[#probeLog + 1] = {&#10;&#09;&#09;kind = kind,&#10;&#09;&#09;x = e.x, y = e.y,&#10;&#09;&#09;downX = e:getMouseDownX(), downY = e:getMouseDownY(),&#10;&#09;&#09;dist = e:getDistanceFromDragStart(),&#10;&#09;&#09;distX = e:getDistanceFromDragStartX(), distY = e:getDistanceFromDragStartY(),&#10;&#09;&#09;clicks = e:getNumberOfClicks(),&#10;&#09;&#09;wasClicked = e:mouseWasClicked(),&#10;&#09;&#09;pressLen = e:getLengthOfMousePress(),&#10;&#09;&#09;shift = e.mods:isShiftDown(), ctrl = e.mods:isCtrlDown(), alt = e.mods:isAltDown(),&#10;&#09;&#09;cmd = e.mods:isCommandDown(),&#10;&#09;&#09;left = e.mods:isLeftButtonDown(), right = e.mods:isRightButtonDown(),&#10;&#09;&#09;popup = e.mods:isPopupMenu(),&#10;&#09;&#09;dx = dx, dy = dy&#10;&#09;}&#10;end&#10;&#10;-- The log as &quot;kind@x,y&quot; strings, the shape most assertions want.&#10;probeKinds = function()&#10;&#09;local t = {}&#10;&#09;for i, r in ipairs(probeLog) do t[i] = r.kind .. &quot;@&quot; .. r.x .. &quot;,&quot; .. r.y end&#10;&#09;return t&#10;end" luaMethodLinkedProperty="" luaMethodSource="0" uuid="00000000000000000000000000000050" luaMethodValid="1" />
      <luaMethod luaMethodName="surfacePaint" luaMethodCode="surfacePaint = function(comp, g)&#10;&#09;if probeFailPaint then error(&quot;probeFailPaint is set&quot;) end&#10;&#09;paintCount = paintCount + 1&#10;&#09;g:fillAll(Colour(0xff2060a0))&#10;end" luaMethodLinkedProperty="" luaMethodSource="0" uuid="00000000000000000000000000000051" luaMethodValid="1" />
