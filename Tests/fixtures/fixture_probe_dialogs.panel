      <luaMethodGroup name="Built-In" uuid="49c3f79ca3dc4f868d5cfc5e48e56199">
<luaMethod luaMethodName="dialogsLoaded" luaMethodCode="-- At load: a dialog that only --answer can answer (a script runs after the load).&#10;dialogsLoaded = function()&#10;&#9;loadAnswer = utils.questionWindow(&quot;Dialogs: load&quot;, &quot;Answer at load?&quot;, &quot;Yes&quot;, &quot;No&quot;)&#10;end" luaMethodLinkedProperty="" luaMethodSource="0" uuid="000000000000000000000000000000d0" luaMethodValid="1" />
<luaMethod luaMethodName="dialogsAll" luaMethodCode="-- Every blocking Lua dialog form, with a console line before and after it, so that a probe run&#10;-- shows the answer Lua got and the order Lua saw. The probe answers the dialogs by title&#10;-- (--answer, or a script's &quot;answers&quot;; see Doc/PanelProbe.md); every title starts with &quot;Dialogs: &quot;.&#10;-- openMultipleFilesWindow is called with ':' because it is not static (the '.' form fails).&#10;-- native: pass true only where the probe can answer an OS file chooser (Linux, where it makes&#10;-- JUCE use its own); getDirectoryWindow is always native, so it runs only then.&#10;dlgLog = function(s)&#10;&#9;console(&quot;dlg &quot; .. s)&#10;end&#10;&#10;dlgStep = function(name, fn)&#10;&#9;dlgLog(&quot;before &quot; .. name)&#10;&#9;dlgLog(&quot;answer &quot; .. name .. &quot;=&quot; .. tostring(fn()))&#10;&#9;dlgLog(&quot;after &quot; .. name)&#10;end&#10;&#10;dialogsAll = function(dir, native)&#10;&#9;local d = File(dir)&#10;&#9;dlgStep(&quot;questionWindow&quot;, function()&#10;&#9;&#9;return utils.questionWindow(&quot;Dialogs: question&quot;, &quot;Question?&quot;, &quot;Yes&quot;, &quot;No&quot;)&#10;&#9;end)&#10;&#9;dlgStep(&quot;infoWindow&quot;, function()&#10;&#9;&#9;utils.infoWindow(&quot;Dialogs: info&quot;, &quot;Info&quot;)&#10;&#9;&#9;return &quot;-&quot;&#10;&#9;end)&#10;&#9;dlgStep(&quot;warnWindow&quot;, function()&#10;&#9;&#9;utils.warnWindow(&quot;Dialogs: warn&quot;, &quot;Warning&quot;)&#10;&#9;&#9;return &quot;-&quot;&#10;&#9;end)&#10;&#9;dlgStep(&quot;askForTextInputWindow&quot;, function()&#10;&#9;&#9;return utils.askForTextInputWindow(&quot;Dialogs: text&quot;, &quot;Text?&quot;, &quot;initial&quot;, &quot;label&quot;, false, &quot;OK&quot;, &quot;Cancel&quot;)&#10;&#9;end)&#10;&#9;dlgStep(&quot;showOkCancelBox&quot;, function()&#10;&#9;&#9;return AlertWindow.showOkCancelBox(AlertWindow.QuestionIcon, &quot;Dialogs: ok-cancel&quot;, &quot;OK?&quot;, &quot;OK&quot;, &quot;Cancel&quot;)&#10;&#9;end)&#10;&#9;dlgStep(&quot;showYesNoCancelBox&quot;, function()&#10;&#9;&#9;return AlertWindow.showYesNoCancelBox(AlertWindow.QuestionIcon, &quot;Dialogs: yes-no-cancel&quot;, &quot;Yes?&quot;, &quot;Yes&quot;, &quot;No&quot;, &quot;Cancel&quot;)&#10;&#9;end)&#10;&#9;dlgStep(&quot;runModalLoop&quot;, function()&#10;&#9;&#9;local w = AlertWindow(&quot;Dialogs: run-modal&quot;, &quot;Go?&quot;, AlertWindow.QuestionIcon)&#10;&#9;&#9;w:addButton(&quot;Go&quot;, 7, KeyPress(), KeyPress())&#10;&#9;&#9;w:addButton(&quot;Stop&quot;, 0, KeyPress(), KeyPress())&#10;&#9;&#9;return w:runModalLoop()&#10;&#9;end)&#10;&#9;dlgStep(&quot;openFileWindow&quot;, function()&#10;&#9;&#9;return utils.openFileWindow(&quot;Dialogs: open&quot;, d, &quot;*.txt&quot;, native):getFileName()&#10;&#9;end)&#10;&#9;dlgStep(&quot;openFileWindow non-native&quot;, function()&#10;&#9;&#9;return utils.openFileWindow(&quot;Dialogs: open non-native&quot;, d, &quot;*.txt&quot;, false):getFileName()&#10;&#9;end)&#10;&#9;dlgStep(&quot;openMultipleFilesWindow&quot;, function()&#10;&#9;&#9;local t = {}&#10;&#9;&#9;utils:openMultipleFilesWindow(&quot;Dialogs: open multiple&quot;, d, &quot;*.txt&quot;, native, t)&#10;&#9;&#9;local names = {}&#10;&#9;&#9;for i, f in ipairs(t) do&#10;&#9;&#9;&#9;names[i] = f:getFileName()&#10;&#9;&#9;end&#10;&#9;&#9;return table.concat(names, &quot;,&quot;)&#10;&#9;end)&#10;&#9;dlgStep(&quot;saveFileWindow&quot;, function()&#10;&#9;&#9;return utils.saveFileWindow(&quot;Dialogs: save&quot;, d, &quot;*.txt&quot;, native):getFileName()&#10;&#9;end)&#10;&#9;if native then&#10;&#9;&#9;dlgStep(&quot;getDirectoryWindow&quot;, function()&#10;&#9;&#9;&#9;return utils.getDirectoryWindow(&quot;Dialogs: directory&quot;, d):getFileName()&#10;&#9;&#9;end)&#10;&#9;end&#10;&#9;return &quot;done&quot;&#10;end" luaMethodLinkedProperty="" luaMethodSource="0" uuid="000000000000000000000000000000d1" luaMethodValid="1" />
      </luaMethodGroup>
    </luaManagerMethods>
  </luaManager>
