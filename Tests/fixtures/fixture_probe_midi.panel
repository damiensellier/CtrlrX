      <luaMethod luaMethodName="probeMidiInit" luaMethodCode="ccCount = 0&#10;midiInCount = 0&#10;tickCount = 0" luaMethodLinkedProperty="" luaMethodSource="0" uuid="00000000000000000000000000000090" luaMethodValid="1" />
      <luaMethod luaMethodName="ccChanged" luaMethodCode="ccChanged = function(mod, value, source)&#10;&#09;ccCount = ccCount + 1&#10;&#09;console(&quot;cc &quot; .. value)&#10;end" luaMethodLinkedProperty="" luaMethodSource="0" uuid="00000000000000000000000000000091" luaMethodValid="1" />
      <luaMethod luaMethodName="sendDump" luaMethodCode="sendDump = function(n)&#10;&#09;local bytes = {0xF0, 0x7D, 0x10}&#10;&#09;for i = 1, 297 do bytes[#bytes + 1] = i % 128 end&#10;&#09;bytes[#bytes + 1] = 0xF7&#10;&#09;panel:sendMidiMessageNow(CtrlrMidiMessage(MemoryBlock(bytes)))&#10;&#09;for i = 1, n do&#10;&#09;&#09;panel:sendMidiMessageNow(CtrlrMidiMessage(MemoryBlock({0xB0, 0x30, i % 128})))&#10;&#09;end&#10;&#09;return n + 1&#10;end" luaMethodLinkedProperty="" luaMethodSource="0" uuid="00000000000000000000000000000092" luaMethodValid="1" />
      <luaMethod luaMethodName="dumpBtnChanged" luaMethodCode="dumpBtnChanged = function(mod, value, source)&#10;&#09;sendDump(70)&#10;end" luaMethodLinkedProperty="" luaMethodSource="0" uuid="00000000000000000000000000000093" luaMethodValid="1" />
      <luaMethod luaMethodName="midiIn" luaMethodCode="midiIn = function(midi)&#10;&#09;midiInCount = midiInCount + 1&#10;&#09;local d = midi:getData()&#10;&#09;local size = math.floor(tonumber(d:getSize()))&#10;&#09;if size &gt; 3 and d:getByte(0) == 0xF0 and d:getByte(1) == 0x7D and d:getByte(2) == 0x01 then&#10;&#09;&#09;panel:sendMidiMessageNow(CtrlrMidiMessage(MemoryBlock({0xF0, 0x7D, 0x02, size % 128, 0xF7})))&#10;&#09;end&#10;&#09;console(&quot;in &quot; .. size)&#10;end" luaMethodLinkedProperty="" luaMethodSource="0" uuid="00000000000000000000000000000094" luaMethodValid="1" />
      <luaMethod luaMethodName="startTick" luaMethodCode="startTick = function(ms)&#10;&#09;timer:setCallback(7, function(id)&#10;&#09;&#09;timer:stopTimer(id)&#10;&#09;&#09;tickCount = tickCount + 1&#10;&#09;&#09;panel:sendMidiMessageNow(CtrlrMidiMessage(MemoryBlock({0xB0, 0x1E, 0x63})))&#10;&#09;&#09;console(&quot;tick&quot;)&#10;&#09;end)&#10;&#09;timer:startTimer(7, ms)&#10;&#09;return ms&#10;end" luaMethodLinkedProperty="" luaMethodSource="0" uuid="00000000000000000000000000000095" luaMethodValid="1" />
      <luaMethod luaMethodName="startBadTick" luaMethodCode="startBadTick = function(ms)&#10;&#09;timer:setCallback(8, function(id)&#10;&#09;&#09;timer:stopTimer(id)&#10;&#09;&#09;error(&quot;tick boom&quot;)&#10;&#09;end)&#10;&#09;timer:startTimer(8, ms)&#10;&#09;return ms&#10;end" luaMethodLinkedProperty="" luaMethodSource="0" uuid="00000000000000000000000000000096" luaMethodValid="1" />
      <luaMethod luaMethodName="argTypes" luaMethodCode="argTypes = function(...)&#10;&#09;local t = {}&#10;&#09;for i = 1, select('#', ...) do t[i] = type((select(i, ...))) end&#10;&#09;return table.concat(t, &quot;,&quot;)&#10;end" luaMethodLinkedProperty="" luaMethodSource="0" uuid="00000000000000000000000000000097" luaMethodValid="1" />
