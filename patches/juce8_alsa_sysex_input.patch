# JUCE 8.0.12 -- ALSA input: join the pieces of a long SysEx from a legacy client
#
# Applies to: JUCE/modules/juce_audio_devices/native/juce_Midi_linux.cpp
# Documentation only: the change is already in the vendored JUCE tree, and CMake
# does not apply this file. It equals
#   git diff <pristine JUCE 8.0.12> HEAD -- JUCE/modules/juce_audio_devices/native/juce_Midi_linux.cpp
# Check from the repo root:  git apply -R --check patches/juce8_alsa_sysex_input.patch
#
# The kernel's rawmidi -> sequencer bridge hands a long SysEx to a legacy (non-UMP)
# sequencer client as several SND_SEQ_EVENT_SYSEX events of at most 256 bytes: the
# first starts with F0, the last ends with F7. JUCE 6 joined them with
# MidiDataConcatenator. JUCE 8.0.12's InputImplNative::pushBytes() converts each
# event to UMP as if it were a whole message, so a SysEx over 256 bytes arrives cut
# off after its first piece. JUCE's client is a legacy one with alsa-lib < 1.2.10
# or a kernel < 6.5 (and always with CtrlrX's test mock); on a UMP client the kernel
# sends SysEx7 and JUCE joins it itself. JUCE develop has the same code.
#
# The patch runs each event through JUCE's own BytestreamSysexExtractor (the state
# machine of MidiDataConcatenator) and converts a SysEx once its F7 has arrived.
# Other messages are converted as before. A SysEx cut short by a new F0 or another
# status byte is dropped; real-time bytes inside it are passed on at once.
#
diff --git a/JUCE/modules/juce_audio_devices/native/juce_Midi_linux.cpp b/JUCE/modules/juce_audio_devices/native/juce_Midi_linux.cpp
index e034d0e06..fe0973f70 100644
--- a/JUCE/modules/juce_audio_devices/native/juce_Midi_linux.cpp
+++ b/JUCE/modules/juce_audio_devices/native/juce_Midi_linux.cpp
@@ -997,13 +997,49 @@ struct AlsaMidiHelpers
             // Bytestream messages that we're sent don't have a built-in group.
             // We currently make a separate endpoint for each bytestream port, rather than combining
             // ports into endpoints, so we can stick with group 0 here.
-            converter.convert ({ 0, view.bytes }, getInputCallback (view.timestamp));
+
+            // CtrlrX: patches/juce8_alsa_sysex_input.patch
+            // A legacy (non-UMP) ALSA client gets a long SysEx as several sequencer events of at
+            // most 256 bytes each. Join the pieces before the conversion, as JUCE 6 did with
+            // MidiDataConcatenator. A SysEx cut short by a new F0 or another status byte is
+            // dropped; real-time bytes inside a SysEx are passed on at once.
+            sysexExtractor.push (view.bytes, [&] (SysexExtractorCallbackKind kind, Span<const std::byte> bytes)
+            {
+                switch (kind)
+                {
+                    case SysexExtractorCallbackKind::notSysex:
+                        converter.convert ({ 0, bytes }, getInputCallback (view.timestamp));
+                        return;
+
+                    case SysexExtractorCallbackKind::ongoingSysex:
+                    case SysexExtractorCallbackKind::lastSysex:
+                    {
+                        if (pendingSysex.empty())
+                            pendingSysexTime = view.timestamp;
+
+                        pendingSysex.insert (pendingSysex.end(), bytes.begin(), bytes.end());
+
+                        if (kind == SysexExtractorCallbackKind::ongoingSysex)
+                            return;
+
+                        if (! pendingSysex.empty() && pendingSysex.back() == std::byte { 0xf7 })
+                            converter.convert ({ 0, Span<const std::byte> (pendingSysex.data(), pendingSysex.size()) },
+                                               getInputCallback (pendingSysexTime));
+
+                        pendingSysex.clear();
+                        return;
+                    }
+                }
+            });
         }
 
         ump::DisconnectionListener& listener;
         std::shared_ptr<Port> port;
         ump::GenericUMPConverter converter;
         ump::Consumer& consumer;
+        BytestreamSysexExtractor sysexExtractor;   // CtrlrX: patches/juce8_alsa_sysex_input.patch
+        std::vector<std::byte> pendingSysex;
+        double pendingSysexTime = 0.0;
     };
 
     class OutputImplNative : public ump::Output::Impl::Native
