# JUCE 6.0.8 -- MidiOutput::sendMessageAt(): queue one message of any size
#
# Applies to: JUCE/modules/juce_audio_devices/midi_io/juce_MidiDevices.{h,cpp}
# Documentation only: the change is already in the vendored JUCE tree, and CMake
# does not apply this file. It equals
#   git diff <pristine JUCE 6.0.8> HEAD -- JUCE/modules/juce_audio_devices/midi_io/
# Check from the repo root:  git apply -R --check patches/juce6_midioutput_send_message_at.patch
#
# MidiOutput's background thread sends timed messages in time order, one at a
# time, but they can only be queued through a MidiBuffer (sendBlockOfMessages()),
# whose events hold at most 65535 bytes (65529 with the 6-byte header). CtrlrX sent
# a longer SysEx with sendMessageNow() on the calling thread instead (#350), which
# raced the background thread on the same port: the order flipped, the global MIDI
# delay was skipped, and on macOS 11+ (a SysEx takes many CoreMIDI calls) the
# packets of a short message landed inside the SysEx, so the receiver dropped it
# (thru D2D on macOS CI, run 43745732738).
#
# The patch adds sendMessageAt(), which puts one MidiMessage into the same queue,
# after the messages with the same or an earlier time. Purely additive.
#
# JUCE 8 (ScheduledEventThread<MidiMessage>) can take the same function as a
# one-liner over outputThread.addEvent().
#
diff --git a/JUCE/modules/juce_audio_devices/midi_io/juce_MidiDevices.cpp b/JUCE/modules/juce_audio_devices/midi_io/juce_MidiDevices.cpp
index df6543769..52b1de1a1 100644
--- a/JUCE/modules/juce_audio_devices/midi_io/juce_MidiDevices.cpp
+++ b/JUCE/modules/juce_audio_devices/midi_io/juce_MidiDevices.cpp
@@ -73,6 +73,37 @@ void MidiOutput::sendBlockOfMessages (const MidiBuffer& buffer,
     notify();
 }
 
+// CtrlrX: patches/juce6_midioutput_send_message_at.patch
+void MidiOutput::sendMessageAt (const MidiMessage& message, double millisecondCounterToSendAt)
+{
+    // You've got to call startBackgroundThread() for this to actually work..
+    jassert (isThreadRunning());
+
+    auto* m = new PendingMessage (message.getRawData(), message.getRawDataSize(), millisecondCounterToSendAt);
+
+    {
+        const ScopedLock sl (lock);
+
+        if (firstMessage == nullptr || firstMessage->message.getTimeStamp() > millisecondCounterToSendAt)
+        {
+            m->next = firstMessage;
+            firstMessage = m;
+        }
+        else
+        {
+            auto* mm = firstMessage;
+
+            while (mm->next != nullptr && mm->next->message.getTimeStamp() <= millisecondCounterToSendAt)
+                mm = mm->next;
+
+            m->next = mm->next;
+            mm->next = m;
+        }
+    }
+
+    notify();
+}
